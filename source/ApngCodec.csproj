<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>Preview</LangVersion>
    <Platforms>x64;ARM64</Platforms>

    <!-- Native shared library produced by Native AOT. -->
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <!-- .NET 11 prefixes Unix libraries with "lib" by default; keep the name every release has shipped. -->
    <UseNativeLibPrefix>false</UseNativeLibPrefix>
    <SelfContained>true</SelfContained>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>

    <!-- Resulting binary name MUST match the manifest's "executable" field. -->
    <AssemblyName>ApngCodec</AssemblyName>
    <RootNamespace>ApngCodec</RootNamespace>

    <!-- Keep in sync with "version" in igplugin.json. -->
    <Version>1.4.1</Version>
    <Product>APNG Codec for ImageGlass</Product>
    <Authors>Duong Dieu Phap</Authors>
    <Copyright>Copyright (C) 2026 Duong Dieu Phap</Copyright>

    <!-- Plugin library: not a NuGet package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImageGlass.SDK" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Manifest must sit next to the published library so the host can discover the plugin. -->
    <None Update="igplugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
    The host only accepts a manifest "executable" naming the published native library, so
    rewrite the published copy with the file name Native AOT actually wrote. The checked-in
    manifest keeps the Windows name.
  -->
  <Target Name="StampPluginManifestExecutable" AfterTargets="Publish">
    <PropertyGroup>
      <_PluginLibName>$([System.IO.Path]::GetFileName('$(NativeBinary)'))</_PluginLibName>
      <_PluginManifest>$(PublishDir)igplugin.json</_PluginManifest>
      <_StampManifest>false</_StampManifest>
      <_StampManifest Condition="'$(_PluginLibName)' != '' And '$(_PluginLibName)' != '$(AssemblyName).dll' And Exists('$(_PluginManifest)')">true</_StampManifest>
      <_PluginManifestText Condition="'$(_StampManifest)' == 'true'">$([System.IO.File]::ReadAllText('$(_PluginManifest)'))</_PluginManifestText>
      <_PluginManifestText Condition="'$(_StampManifest)' == 'true'">$(_PluginManifestText.Replace('$(AssemblyName).dll', '$(_PluginLibName)'))</_PluginManifestText>
    </PropertyGroup>

    <WriteLinesToFile Condition="'$(_StampManifest)' == 'true'"
                      File="$(_PluginManifest)"
                      Lines="$(_PluginManifestText)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <Message Condition="'$(_StampManifest)' == 'true'" Importance="high"
             Text="igplugin.json executable stamped as $(_PluginLibName)" />
  </Target>
</Project>
